  useCallback,
  useEffect,
  useMemo,
  useState,
} from 'react';
import {
  ChevronLeft,
  ChevronRight,
  Eye,
  Loader2,
  RefreshCw,
  Search,
  ShieldCheck,
  X,
} from 'lucide-react';

import { useAuth } from '@/components/auth/auth-provider';
import { SuperAdminPasswordResetPanel } from '@/components/activity-logs/super-admin-password-reset-panel';

type Tab =
  | 'activity'
  | 'login';

type UserInfo = {
  id: string;
  email?: string | null;
  phone?: string | null;
  employeeProfile?: {
    id: string;
    employeeId: string;
    fullName: string;
    username?: string | null;
    designation?: string | null;
    profileImageUrl?: string | null;
  } | null;
};

type ActivityRow = {
  id: string;
  userId?: string | null;
  action: string;
  entityType: string;
  entityId?: string | null;
  ipAddress?: string | null;
  userAgent?: string | null;
  previousValue?: unknown;
  newValue?: unknown;
  metadata?: unknown;
  createdAt: string;
  user?: UserInfo | null;
};

type LoginRow = {
  id: string;
  userId?: string | null;
  eventType: string;
  identifier?: string | null;
  ipAddress?: string | null;
  userAgent?: string | null;
  deviceName?: string | null;
  browser?: string | null;
  os?: string | null;
  failureReason?: string | null;
  createdAt: string;
  user?: UserInfo | null;
};

type PageData<T> = {
  page: number;
  limit: number;
  total: number;
  totalPages: number;
  rows: T[];
};

type Options = {
  actions: string[];
  entityTypes: string[];
  users: Array<{
    id: string;
    label: string;
    employeeId?: string | null;
    username?: string | null;
    email?: string | null;
  }>;
  loginEventTypes: string[];
};

function localDate(
  date: Date,
) {
  const copy =
    new Date(
      date.getTime() -
        date.getTimezoneOffset() *
          60000,
    );

  return copy
    .toISOString()
    .slice(
      0,
      10,
    );
}

function defaultDates() {
  const end =
    new Date();

  end.setDate(
    end.getDate() +
      1,
  );

  const start =
    new Date();

  start.setDate(
    start.getDate() -
      6,
  );

  return {
    start:
      localDate(
        start,
      ),
    end:
      localDate(
        end,
      ),
  };
}

function actorName(
  user?: UserInfo | null,
) {
  return (
    user?.employeeProfile?.fullName ??
    user?.email ??
    user?.phone ??
    'System / Unknown'
  );
}

function formatAction(
  value: string,
) {
  return value
    .replace(
      /_/g,
      ' ',
    )
    .toLowerCase()
    .replace(
      /\b\w/g,
      (letter) =>
        letter.toUpperCase(),
    );
}

function jsonText(
  value: unknown,
) {
  if (
    value === null ||
    value === undefined
  ) {
    return 'â€”';
  }

  try {
    return JSON.stringify(
      value,
      null,
      2,
    );
  } catch {
    return String(
      value,
    );
  }
}

export default function ActivityLogsPage() {
  const {
    authFetch,
  } =
    useAuth();

  const dates =
    useMemo(
      () =>
        defaultDates(),
      [],
    );

  const [
    tab,
    setTab,
  ] =
    useState<Tab>(
      'activity',
    );

  const [
    search,
    setSearch,
  ] =
    useState('');

  const [
    userId,
    setUserId,
  ] =
    useState('');

  const [
    action,
    setAction,
  ] =
    useState('');

  const [
    entityType,
    setEntityType,
  ] =
    useState('');

  const [
    eventType,
    setEventType,
  ] =
    useState('');

  const [
    start,
    setStart,
  ] =
    useState(
      dates.start,
    );

  const [
    end,
    setEnd,
  ] =
    useState(
      dates.end,
    );

  const [
    sort,
    setSort,
  ] =
    useState(
      'newest',
    );

  const [
    page,
    setPage,
  ] =
    useState(1);

  const [
    activityData,
    setActivityData,
  ] =
    useState<PageData<ActivityRow> | null>(
      null,
    );

  const [
    loginData,
    setLoginData,
  ] =
    useState<PageData<LoginRow> | null>(
      null,
    );

  const [
    options,
    setOptions,
  ] =
    useState<Options>({
      actions: [],
      entityTypes: [],
      users: [],
      loginEventTypes: [],
    });

  const [
    loading,
    setLoading,
  ] =
    useState(true);

  const [
    error,
    setError,
  ] =
    useState('');

  const [
    detail,
    setDetail,
  ] =
    useState<
      | {
          type:
            'activity';
          row:
            ActivityRow;
        }
      | {
          type:
            'login';
          row:
            LoginRow;
        }
      | null
    >(
      null,
    );

  const request =
    useCallback(
      async <T,>(
        path: string,
      ): Promise<T> => {
        const response =
          await authFetch(
            path,
          );

        let body:
          | any
          | null = null;

        try {
          body =
            await response.json();
        } catch {
          body =
            null;
        }

        if (
          !response.ok
        ) {
          throw new Error(
            Array.isArray(
              body?.message,
            )
              ? body.message.join(
                  ', ',
                )
              : body?.message ??
                'Request failed.',
          );
        }

        return body as T;
      },
      [authFetch],
    );

  const params =
    useCallback(
      (
        activeTab:
          Tab,
      ) => {
        const value =
          new URLSearchParams();

        value.set(
          'page',
          String(page),
        );

        value.set(
          'limit',
          '50',
        );

        value.set(
          'sort',
          sort,
        );

        if (
          search.trim()
        ) {
          value.set(
            'search',
            search.trim(),
          );
        }

        if (userId) {
          value.set(
            'userId',
            userId,
          );
        }

        if (start) {
          value.set(
            'start',
            new Date(
              `${start}T00:00:00`,
            ).toISOString(),
          );
        }

        if (end) {
          value.set(
            'end',
            new Date(
              `${end}T00:00:00`,
            ).toISOString(),
          );
        }

        if (
          activeTab ===
          'activity'
        ) {
          if (action) {
            value.set(
              'action',
              action,
            );
          }

          if (
            entityType
          ) {
            value.set(
              'entityType',
              entityType,
            );
          }
        } else if (
          eventType
        ) {
          value.set(
            'eventType',
            eventType,
          );
        }

        return value;
      },
      [
        page,
        sort,
        search,
        userId,
        start,
        end,
        action,
        entityType,
        eventType,
      ],
    );

  const load =
    useCallback(
      async () => {
        setLoading(
          true,
        );
        setError('');

        try {
          const query =
            params(
              tab,
            );

          const nextOptions =
            await request<Options>(
              '/activity-logs/options',
            );

          setOptions(
            nextOptions,
          );

          if (
            tab ===
            'activity'
          ) {
            const result =
              await request<
                PageData<ActivityRow>
              >(
                `/activity-logs?${query.toString()}`,
              );

            setActivityData(
              result,
            );
          } else {
            const result =
              await request<
                PageData<LoginRow>
              >(
                `/activity-logs/login-history?${query.toString()}`,
              );

            setLoginData(
              result,
            );
          }
        } catch (err) {
          setError(
            err instanceof Error
              ? err.message
              : 'Unable to load activity logs.',
          );
        } finally {
          setLoading(
            false,
          );
        }
      },
      [
        params,
        request,
        tab,
      ],
    );

  useEffect(() => {
    void load();
  }, [load]);

  const current =
    tab ===
    'activity'
      ? activityData
      : loginData;

  const changeTab =
    (
      next:
        Tab,
    ) => {
      setTab(
        next,
      );
      setPage(
        1,
      );
      setAction(
        '',
      );
      setEntityType(
        '',
      );
      setEventType(
        '',
      );
    };

  return (
    <div className="mx-auto w-full max-w-[1700px] space-y-6 pb-12">
        <SuperAdminPasswordResetPanel />
      <div className="flex flex-wrap items-start justify-between gap-4">
        <div className="flex items-center gap-3">
          <div className="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-900 text-white">
            <ShieldCheck className="h-5 w-5" />
          </div>

          <div>
            <h1 className="text-2xl font-black tracking-tight text-slate-950">
              Activity & Audit Logs
            </h1>

          </div>
        </div>

        <button
          type="button"
          onClick={() =>
            void load()
          }
          className="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-black text-slate-700 shadow-sm"
        >
          <RefreshCw className="h-4 w-4" />
          Refresh
        </button>
      </div>

      {error && (
        <div className="rounded-2xl border border-red-100 bg-red-50 p-4 text-sm font-bold text-red-700">
          {error}
        </div>
      )}

      <div className="flex gap-2 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm">
        <button
          type="button"
          onClick={() =>
            changeTab(
              'activity',
            )
          }
          className={`rounded-xl px-4 py-2 text-sm font-black ${
            tab ===
            'activity'
              ? 'bg-slate-950 text-white'
              : 'text-slate-500 hover:bg-slate-100'
          }`}
        >
          Activity Log
        </button>

        <button
          type="button"
          onClick={() =>
            changeTab(
              'login',
            )
          }
          className={`rounded-xl px-4 py-2 text-sm font-black ${
            tab ===
            'login'
              ? 'bg-slate-950 text-white'
              : 'text-slate-500 hover:bg-slate-100'
          }`}
        >
          Login History
        </button>
      </div>

      <section className="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
        <div className="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
          <div className="relative">
            <Search className="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />

            <input
              value={
                search
              }
              onChange={(
                event,
              ) =>
                setSearch(
                  event.target.value,
                )
              }
              placeholder={
                tab ===
                'activity'
                  ? 'Search action, entity, user...'
                  : 'Search user, IP, browser...'
              }
              className="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-3 text-sm"
            />
          </div>

          <select
            value={
              userId
            }
            onChange={(
              event,
            ) =>
              setUserId(
                event.target.value,
              )
            }
            className="rounded-xl border border-slate-200 px-3 py-2.5 text-sm"
          >
            <option value="">
              All Users
            </option>

            {options.users.map(
              (user) => (
                <option
                  key={
                    user.id
                  }
                  value={
                    user.id
                  }
                >
                  {user.label}
                </option>
              ),
            )}
          </select>

          {tab ===
          'activity' ? (
            <>
              <select
                value={
                  action
                }
                onChange={(
                  event,
                ) =>
                  setAction(
                    event.target.value,
                  )
                }
                className="rounded-xl border border-slate-200 px-3 py-2.5 text-sm"
              >
                <option value="">
                  All Actions
                </option>

                {options.actions.map(
                  (
                    item,
                  ) => (
                    <option
                      key={
                        item
                      }
                      value={
                        item
                      }
                    >
                      {formatAction(
                        item,
                      )}
                    </option>
                  ),
                )}
              </select>

              <select
                value={
                  entityType
                }
                onChange={(
                  event,
                ) =>
                  setEntityType(
                    event.target.value,
                  )
                }
                className="rounded-xl border border-slate-200 px-3 py-2.5 text-sm"
              >
                <option value="">
                  All Entity Types
                </option>

                {options.entityTypes.map(
                  (
                    item,
                  ) => (
                    <option
                      key={
                        item
                      }
                      value={
                        item
                      }
                    >
                      {formatAction(
                        item,
                      )}
                    </option>
                  ),
                )}
              </select>
            </>
          ) : (
            <select
              value={
                eventType
              }
              onChange={(
                event,
              ) =>
                setEventType(
                  event.target.value,
                )
              }
              className="rounded-xl border border-slate-200 px-3 py-2.5 text-sm md:col-span-2"
            >
              <option value="">
                All Login Events
              </option>

              {options.loginEventTypes.map(
                (
                  item,
                ) => (
                  <option
                    key={
                      item
                    }
                    value={
                      item
                    }
                  >
                    {formatAction(
                      item,
                    )}
                  </option>
                ),
              )}
            </select>
          )}

          <input
            type="date"
            value={
              start
            }
            onChange={(
              event,
            ) =>
              setStart(
                event.target.value,
              )
            }
            className="rounded-xl border border-slate-200 px-3 py-2.5 text-sm"
          />

          <input
            type="date"
            value={
              end
            }
            onChange={(
              event,
            ) =>
              setEnd(
                event.target.value,
              )
            }
            className="rounded-xl border border-slate-200 px-3 py-2.5 text-sm"
          />

          <select
            value={
              sort
            }
            onChange={(
              event,
            ) =>
              setSort(
                event.target.value,
              )
            }
            className="rounded-xl border border-slate-200 px-3 py-2.5 text-sm"
          >
            <option value="newest">
              Newest First
            </option>
            <option value="oldest">
              Oldest First
            </option>
          </select>

          <button
            type="button"
            onClick={() => {
              setPage(
                1,
              );
              void load();
            }}
            className="rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-black text-white"
          >
            Apply Filters
          </button>
        </div>
      </section>

      <section className="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm">
        {loading ? (
          <div className="flex min-h-[360px] items-center justify-center gap-2 text-sm font-bold text-slate-500">
            <Loader2 className="h-5 w-5 animate-spin" />
            Loading logs...
          </div>
        ) : tab ===
          'activity' ? (
          <ActivityTable
            rows={
              activityData?.rows ??
              []
            }
            onView={(
              row,
            ) =>
              setDetail({
                type:
                  'activity',
                row,
              })
            }
          />
        ) : (
          <LoginTable
            rows={
              loginData?.rows ??
              []
            }
            onView={(
              row,
            ) =>
              setDetail({
                type:
                  'login',
                row,
              })
            }
          />
        )}

        <div className="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
          <p className="text-xs font-bold text-slate-400">
            {current
              ? `${current.total} records Â· Page ${current.page} of ${current.totalPages}`
              : '0 records'}
          </p>

          <div className="flex gap-2">
            <button
              type="button"
              disabled={
                !current ||
                current.page <=
                  1
              }
              onClick={() =>
                setPage(
                  (
                    value,
                  ) =>
                    Math.max(
                      1,
                      value -
                        1,
                    ),
                )
              }
              className="inline-flex items-center gap-1 rounded-xl border border-slate-200 px-3 py-2 text-xs font-black disabled:opacity-40"
            >
              <ChevronLeft className="h-4 w-4" />
              Previous
            </button>

            <button
              type="button"
              disabled={
                !current ||
                current.page >=
                  current.totalPages
              }
              onClick={() =>
                setPage(
                  (
                    value,
                  ) =>
                    value +
                    1,
                )
              }
              className="inline-flex items-center gap-1 rounded-xl border border-slate-200 px-3 py-2 text-xs font-black disabled:opacity-40"
            >
              Next
              <ChevronRight className="h-4 w-4" />
            </button>
          </div>
        </div>
      </section>

      {detail && (
        <DetailModal
          detail={
            detail
          }
          onClose={() =>
            setDetail(
              null,
            )
          }
        />
      )}
    </div>
  );
}

